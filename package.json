{
  "name": "rstream",
  "version": "1.0.0",
  "description": "Rstream - Plateforme de streaming avec interface d'administration",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "start:streaming": "cd frontend/streaming && python3 -m http.server 3000",
    "start:admin": "cd frontend/admin && python3 -m http.server 3001",
    "start:all": "concurrently \"npm run start:backend\" \"npm run start:streaming\" \"npm run start:admin\"",
    "dev": "nodemon backend/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "path": "^0.12.7",
    "fs": "^0.0.1-security",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
